<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.Maui.Diagnostics.Sample.MainPage"
             Title="Diagnostics">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">
            <Label Text="Plugin.Maui.Diagnostics" FontSize="22" FontAttributes="Bold" />
            <Label Text="What happened before the crash?"
                   TextColor="Gray" />

            <Button Text="Login success" Clicked="OnLoginClicked" />
            <Button Text="Open order screen" Clicked="OnOrderClicked" />
            <Button Text="API request (success)" Clicked="OnApiSuccessClicked" />
            <Button Text="Network lost" Clicked="OnNetworkLostClicked" />
            <Button Text="Network restored" Clicked="OnNetworkRestoredClicked" />
            <Button Text="API retry + failure" Clicked="OnApiRetryClicked" />
            <Button Text="Track exception" Clicked="OnExceptionClicked" />
            <Button Text="Freeze UI (ANR)" Clicked="OnAnrClicked" />
            <Button Text="Crash this session" Clicked="OnCrashClicked" BackgroundColor="#B00020" />
            <Button Text="Generate report" Clicked="OnReportClicked" />

            <Label Text="Timeline" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label x:Name="TimelineLabel" FontFamily="Courier New" FontSize="13" LineBreakMode="WordWrap" />

            <Label Text="Report" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label x:Name="ReportLabel" FontSize="13" LineBreakMode="WordWrap" Text="Tap Generate report." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
